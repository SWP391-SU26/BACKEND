# Optional: use OpenAI for generation and/or embeddings.
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Recommended default.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# Alternative embedding providers:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
#
# EMBEDDING_PROVIDER=sentence-transformers
# EMBEDDING_MODEL=BAAI/bge-m3

TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MIN_RETRIEVAL_SCORE=0.2
SEMANTIC_WEIGHT=0.4
APP_DB_PATH=data/db/chatbot.sqlite3
MODEL_CACHE_DIR=data/models_cache/hub
GENERATION_PROVIDER=local
LOCAL_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LORA_ADAPTER_DIR=models/qwen2.5-1.5b-triethoc-lora-v1
LOCAL_MAX_INPUT_TOKENS=2048
LOCAL_MAX_NEW_TOKENS=256
BENCHMARK_BATCH_SIZE=4
BENCHMARK_MAX_NEW_TOKENS=192
BENCHMARK_MAX_INPUT_TOKENS=1536
# VNPay Sandbox payment gateway. Copy real credentials only into the ignored
# .env file; never commit VNPAY_HASH_SECRET.
VNPAY_ENABLED=false
VNPAY_ENVIRONMENT=sandbox
VNPAY_TMN_CODE=replace_with_sandbox_tmn_code
VNPAY_HASH_SECRET=replace_with_sandbox_hash_secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Local Sandbox works without a tunnel: VNPay redirects the browser to this
# signed Return URL and the backend performs an idempotent settlement.
VNPAY_RETURN_URL=http://localhost:8080/api/payments/vnpay/return
# Optional in local Sandbox. Set a stable public HTTPS URL to test server-to-server IPN.
VNPAY_IPN_URL=
FRONTEND_PAYMENT_RETURN_URL=http://localhost:5173/payment/result
VNPAY_ORDER_TTL_MINUTES=15
