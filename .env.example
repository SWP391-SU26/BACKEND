# Optional: use OpenAI for generation and/or embeddings.
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Recommended default.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-m3

# Alternative embedding providers:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
#
# EMBEDDING_PROVIDER=sentence-transformers
# EMBEDDING_MODEL=BAAI/bge-m3

TOP_K=10
CHUNK_SIZE=700
CHUNK_OVERLAP=120
MIN_RETRIEVAL_SCORE=0.2
SEMANTIC_WEIGHT=0.4
APP_DB_PATH=data/db/chatbot.sqlite3
MODEL_CACHE_DIR=data/models_cache/hub
GENERATION_PROVIDER=auto
LOCAL_BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
LORA_ADAPTER_DIR=models/qwen-rag-lora
LOCAL_MAX_NEW_TOKENS=40
